  "standard_templates": [
    {
      "id": "lower-bound",
      "name": "標準模板：第一個不小於 target 的位置",
      "trigger_signal": "已排序陣列，判斷 nums[i] >= target 由 false 轉為 true。",
      "keywords": [
        "已排序",
        "第一個",
        "lower bound",
        "二分"
      ],
      "prerequisites": [
        "nums 以非遞減順序排列，空陣列可回傳 0。",
        "回傳索引可能等於 n，代表不存在符合條件的元素。"
      ],
      "counterexamples": [
        {
          "scenario": "nums=[3,1,2], target=2",
          "reason": "未排序時判斷結果不是單調序列，不能保證淘汰半邊仍保留答案。"
        }
      ],
      "explanation": "維護左閉右開區間 [left,right)。mid 符合條件時保留它作為候選，因此 right=mid；不符合時 left=mid+1。迴圈結束的 left 是第一個符合位置或 n。不要把回傳 n 誤當有效索引。",
      "complexity": {
        "time": "O(log n)",
        "space": "O(1)",
        "reason": "每回合至少縮小一半區間，只保留三個索引。"
      },
      "code": {
        "python": {
          "lines": [
            "def lower_bound(nums, target):",
            "    left, right = 0, len(nums)  # 左閉右開",
            "    while left < right:",
            "        mid = left + (right - left) // 2",
            "        if nums[mid] >= target:  # mid 仍可能是第一個",
            "            right = mid",
            "        else:",
            "            left = mid + 1  # mid 與左側都太小",
            "    return left  # 可能等於 len(nums)"
          ]
        },
        "java": {
          "lines": [
            "class Solution {",
            "    public int lowerBound(int[] nums, int target) {",
            "        int left = 0, right = nums.length; // 左閉右開",
            "        while (left < right) {",
            "            int mid = left + (right - left) / 2; // 避免 left+right 溢位",
            "            if (nums[mid] >= target) right = mid; // 保留候選",
            "            else left = mid + 1;",
            "        }",
            "        return left; // 可能等於 n",
            "    }",
            "}"
          ]
        },
        "cpp": {
          "lines": [
            "#include <vector>",
            "int lowerBound(const std::vector<int>& nums, int target) {",
            "    int left = 0, right = static_cast<int>(nums.size()); // 左閉右開",
            "    while (left < right) {",
            "        int mid = left + (right - left) / 2;",
            "        if (nums[mid] >= target) right = mid; // 保留候選",
            "        else left = mid + 1;",
            "    }",
            "    return left; // 可能等於 n",
            "}"
          ]
        }
      },
