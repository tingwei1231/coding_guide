      "code": {
        "python": {
          "lines": [
            "def binary_search(nums, target):",
            "    left, right = 0, len(nums) - 1  # 閉區間",
            "    while left <= right:",
            "        mid = left + (right - left) // 2",
            "        if nums[mid] == target:",
            "            return mid  # 相等即結束",
            "        if nums[mid] < target:",
