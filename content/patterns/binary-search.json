    {
      "id": "boundaries",
      "name": "找左／右邊界",
      "trigger_signal": "找第一個與最後一個 target 的位置，允許重複。",
      "keywords": [
        "第一個",
        "最後一個",
        "邊界",
        "重複"
      ],
      "prerequisites": [
        "nums 非遞減排序；target 可為任意 int。"
      ],
      "counterexamples": [
        {
          "scenario": "用 lower_bound(target+1) 取得右邊界，target 已是最大整數。",
          "reason": "target+1 可能溢位，應直接二分第一個 > target 的位置。"
        }
      ],
      "explanation": "先找 >= target 的第一個位置，再找 > target 的第一個位置。若左邊界越界或不是 target，回傳 [-1,-1]；否則右端答案是第二次搜尋結果減一。",
      "complexity": {
        "time": "O(log n)",
        "space": "O(1)",
        "reason": "兩次二分仍為 O(log n)，不逐一掃描重複區段。"
      },
      "code": {
        "python": {
          "lines": [
            "def search_range(nums, target):",
            "    def bound(strict):",
            "        left, right = 0, len(nums)",
            "        while left < right:",
            "            mid = left + (right - left) // 2",
            "            if nums[mid] > target or (not strict and nums[mid] == target):",
            "                right = mid  # strict=False 找 >=，True 找 >",
            "            else:",
            "                left = mid + 1",
            "        return left",
            "    first = bound(False)",
            "    if first == len(nums) or nums[first] != target:",
            "        return [-1, -1]  # 不存在",
            "    return [first, bound(True) - 1]"
          ]
        },
        "java": {
          "lines": [
            "class Solution {",
            "    private int bound(int[] nums, int target, boolean strict) {",
            "        int left = 0, right = nums.length;",
            "        while (left < right) {",
            "            int mid = left + (right - left) / 2;",
            "            if (nums[mid] > target || (!strict && nums[mid] == target)) right = mid;",
            "            else left = mid + 1;",
            "        }",
            "        return left;",
            "    }",
            "    public int[] searchRange(int[] nums, int target) {",
            "        int first = bound(nums, target, false); // 第一個 >=",
            "        if (first == nums.length || nums[first] != target) return new int[]{-1, -1};",
            "        return new int[]{first, bound(nums, target, true) - 1}; // 第一個 > 減一",
            "    }",
            "}"
          ]
        },
        "cpp": {
          "lines": [
            "#include <vector>",
            "std::vector<int> searchRange(const std::vector<int>& nums, int target) {",
            "    auto bound = [&](bool strict) {",
            "        int left = 0, right = static_cast<int>(nums.size());",
            "        while (left < right) {",
            "            int mid = left + (right - left) / 2;",
            "            if (nums[mid] > target || (!strict && nums[mid] == target)) right = mid;",
            "            else left = mid + 1;",
            "        }",
            "        return left;",
            "    };",
            "    int first = bound(false); // 第一個 >=",
            "    if (first == static_cast<int>(nums.size()) || nums[first] != target) return {-1, -1};",
            "    return {first, bound(true) - 1}; // 第一個 > 減一",
            "}"
          ]
        }
      },
