      "id": "sorted-pair",
      "name": "標準模板：排序陣列的兩數之和",
      "trigger_signal": "非遞減陣列中找兩個不同位置，總和等於 target。",
      "keywords": [
        "兩數之和",
        "排序",
        "對撞指標"
      ],
      "prerequisites": [
        "nums 已非遞減排序；回傳一組 1-based 索引，無解回傳空陣列。",
        "Java/C++ 以 64 位計算兩數總和，避免 int 相加溢位。"
      ],
      "counterexamples": [
        {
          "scenario": "nums=[3,2,4], target=6",
          "reason": "未排序時不能由總和大小決定捨棄哪端；若先排序還需另外保存原始索引。"
        }
      ],
      "explanation": "兩端總和太小，固定左端與任何更小右端只會更小，因此淘汰左端。總和太大則淘汰右端。這個推理依賴排序；left<right 確保不重用同一位置。",
      "complexity": {
        "time": "O(n)",
        "space": "O(1)",
        "reason": "左右端總共移動至多 n 次，輸出只有兩個索引。"
      },
      "code": {
        "python": {
          "lines": [
            "def two_sum_sorted(nums, target):",
            "    left, right = 0, len(nums) - 1",
            "    while left < right:  # 不使用同一個元素兩次",
            "        total = nums[left] + nums[right]",
            "        if total == target:",
            "            return [left + 1, right + 1]  # 題目採 1-based",
            "        if total < target:",
            "            left += 1  # 淘汰偏小的左端",
            "        else:",
            "            right -= 1",
            "    return []"
          ]
        },
        "java": {
          "lines": [
            "class Solution {",
            "    public int[] twoSumSorted(int[] nums, int target) {",
            "        int left = 0, right = nums.length - 1;",
            "        while (left < right) {",
            "            long total = (long) nums[left] + nums[right]; // 先轉型",
            "            if (total == target) return new int[]{left + 1, right + 1};",
            "            if (total < target) left++;",
            "            else right--;",
            "        }",
            "        return new int[0]; // 無解",
            "    }",
            "}"
          ]
        },
        "cpp": {
          "lines": [
            "#include <vector>",
            "std::vector<int> twoSumSorted(const std::vector<int>& nums, int target) {",
            "    int left = 0, right = static_cast<int>(nums.size()) - 1;",
            "    while (left < right) {",
            "        long long total = static_cast<long long>(nums[left]) + nums[right];",
            "        if (total == target) return {left + 1, right + 1};",
            "        if (total < target) ++left;",
            "        else --right;",
            "    }",
            "    return {};",
            "}"
          ]
        }
      },
      "problem_ids": [
        "leetcode-167"
      ],
