    {
      "id": "in-place",
      "name": "原地分割：移動零",
      "trigger_signal": "保留非零元素的相對順序，把零移到尾端。",
      "keywords": [
        "原地",
        "移動零",
        "移除元素",
        "寫入指標"
      ],
      "prerequisites": [
        "允許修改輸入，不排序；讀指標永遠不落後於寫指標。",
        "範例回傳 void/None，結果位於原陣列。"
      ],
      "counterexamples": [
        {
          "scenario": "遇到零便和最後一個非零值交換。",
          "reason": "會改變非零元素相對順序，無法滿足穩定移動的要求。"
        }
      ],
      "explanation": "read 掃描元素，遇到非零就寫到 write，再前進 write。write<=read 保證不會覆蓋未讀資料。最後將 write 之後補零。若改成排序陣列去重，保留條件改為第一個元素或不同於上個已寫值，回傳新長度即可，不要補零。",
      "complexity": {
        "time": "O(n)",
        "space": "O(1)",
        "reason": "一次掃描加一次尾段補零，未建立新陣列。"
      },
      "code": {
        "python": {
          "lines": [
            "def move_zeroes(nums):",
            "    write = 0  # 下一個非零元素的寫入位置",
            "    for read in range(len(nums)):",
            "        if nums[read] != 0:",
            "            nums[write] = nums[read]",
            "            write += 1",
            "    for i in range(write, len(nums)):",
            "        nums[i] = 0  # 只補尾段"
          ]
        },
        "java": {
          "lines": [
            "class Solution {",
            "    public void moveZeroes(int[] nums) {",
            "        int write = 0;",
            "        for (int read = 0; read < nums.length; read++) {",
            "            if (nums[read] != 0) {",
            "                nums[write] = nums[read];",
            "                write++;",
            "            }",
            "        }",
            "        for (int i = write; i < nums.length; i++) nums[i] = 0;",
            "    }",
            "}"
          ]
        },
        "cpp": {
          "lines": [
            "#include <vector>",
            "void moveZeroes(std::vector<int>& nums) {",
            "    int write = 0;",
            "    for (int read = 0; read < static_cast<int>(nums.size()); ++read) {",
            "        if (nums[read] != 0) {",
            "            nums[write] = nums[read];",
            "            ++write;",
            "        }",
            "    }",
            "    for (int i = write; i < static_cast<int>(nums.size()); ++i) nums[i] = 0;",
            "}"
          ]
        }
      },
