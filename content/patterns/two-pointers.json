    {
      "id": "three-sum",
      "name": "多指標：三數之和",
      "trigger_signal": "找所有不重複的三個值組合，總和為 0。",
      "keywords": [
        "三數之和",
        "3sum",
        "多指標",
        "去重"
      ],
      "prerequisites": [
        "可排序輸入；此三語言寫法皆先複製陣列，不修改呼叫端資料。",
        "三個索引必須不同；結果以值去重，Java/C++ 使用 64 位累加。"
      ],
      "counterexamples": [
        {
          "scenario": "nums=[-1,-1,2]，排序後先刪掉所有重複元素。",
          "reason": "重複值可能來自不同合法位置，先去除會丟掉 [-1,-1,2]；只能在選擇層級跳過等價候選。"
        }
      ],
      "explanation": "固定外層 i，把剩餘問題化為左右對撞。外層相同值只處理一次；找到答案後移動兩端，再跳過剛用過的相同值，避免重複組合。少於三個元素回傳空陣列。",
      "complexity": {
        "time": "O(n²)",
        "space": "O(n)，另計輸出 O(r)",
        "reason": "排序 O(n log n)，每個 i 的雙指標 O(n)；複製資料與排序暫存最多線性，r 為輸出三元組數。"
      },
      "code": {
        "python": {
          "lines": [
            "def three_sum(nums):",
            "    values = sorted(nums)  # 複製並排序",
            "    result = []",
            "    for i in range(len(values) - 2):",
            "        if i > 0 and values[i] == values[i - 1]:",
            "            continue  # 跳過同層重複值",
            "        left, right = i + 1, len(values) - 1",
            "        while left < right:",
            "            total = values[i] + values[left] + values[right]",
            "            if total < 0:",
            "                left += 1",
            "            elif total > 0:",
            "                right -= 1",
            "            else:",
            "                result.append([values[i], values[left], values[right]])",
            "                left += 1",
            "                right -= 1",
            "                while left < right and values[left] == values[left - 1]:",
            "                    left += 1",
            "                while left < right and values[right] == values[right + 1]:",
            "                    right -= 1",
            "    return result"
          ]
        },
        "java": {
          "lines": [
            "import java.util.*;",
            "class Solution {",
            "    public List<List<Integer>> threeSum(int[] nums) {",
            "        int[] values = nums.clone(); // 保留呼叫端資料",
            "        Arrays.sort(values);",
            "        List<List<Integer>> result = new ArrayList<>();",
            "        for (int i = 0; i + 2 < values.length; i++) {",
            "            if (i > 0 && values[i] == values[i - 1]) continue;",
            "            int left = i + 1, right = values.length - 1;",
            "            while (left < right) {",
            "                long total = (long) values[i] + values[left] + values[right];",
            "                if (total < 0) left++;",
            "                else if (total > 0) right--;",
            "                else {",
            "                    result.add(Arrays.asList(values[i], values[left], values[right]));",
            "                    left++; right--;",
            "                    while (left < right && values[left] == values[left - 1]) left++;",
            "                    while (left < right && values[right] == values[right + 1]) right--;",
            "                }",
            "            }",
            "        }",
            "        return result;",
            "    }",
            "}"
          ]
        },
        "cpp": {
          "lines": [
            "#include <vector>",
            "#include <algorithm>",
            "std::vector<std::vector<int>> threeSum(const std::vector<int>& nums) {",
            "    std::vector<int> values = nums; // 複製後排序",
            "    std::sort(values.begin(), values.end());",
            "    std::vector<std::vector<int>> result;",
            "    for (int i = 0; i + 2 < static_cast<int>(values.size()); ++i) {",
            "        if (i > 0 && values[i] == values[i - 1]) continue;",
            "        int left = i + 1, right = static_cast<int>(values.size()) - 1;",
            "        while (left < right) {",
            "            long long total = static_cast<long long>(values[i]) + values[left] + values[right];",
            "            if (total < 0) ++left;",
            "            else if (total > 0) --right;",
            "            else {",
            "                result.push_back({values[i], values[left], values[right]});",
            "                ++left; --right;",
            "                while (left < right && values[left] == values[left - 1]) ++left;",
            "                while (left < right && values[right] == values[right + 1]) --right;",
            "            }",
            "        }",
            "    }",
            "    return result;",
            "}"
          ]
        }
      },
