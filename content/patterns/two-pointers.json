      "id": "opposite-ends",
      "name": "對撞指標：容器最大面積",
      "trigger_signal": "兩端位置形成容器，最大化寬度乘以較短高度。",
      "keywords": [
        "對撞",
        "容器",
        "最大面積",
        "短邊"
      ],
      "prerequisites": [
        "height 是非負整數，保留原始順序；不要求排序。",
        "三語言回傳最大面積，少於兩根柱子回傳 0；乘積需在 64 位有號範圍內。"
      ],
      "counterexamples": [
        {
          "scenario": "為了套用雙指標而先排序 height。",
          "reason": "容器寬度來自原始位置；排序改變位置關係，答案會改變。"
        }
      ],
      "explanation": "先記錄目前面積，再移動較短端。若保留較短端只移動較長端，寬度變小且高度上限不會增加，所以無法超越目前面積。相等時移動任一端即可。Two Sum II 則用排序關係淘汰端點，兩者理由不同。",
      "complexity": {
        "time": "O(n)",
        "space": "O(1)",
        "reason": "每輪至少移動一端，最多 n-1 輪。"
      },
      "code": {
        "python": {
          "lines": [
            "def max_area(height):",
            "    left, right = 0, len(height) - 1",
            "    best = 0",
            "    while left < right:",
            "        best = max(best, (right - left) * min(height[left], height[right]))",
            "        if height[left] <= height[right]:  # 淘汰限制面積的短邊",
            "            left += 1",
            "        else:",
            "            right -= 1",
            "    return best"
          ]
        },
        "java": {
          "lines": [
            "class Solution {",
            "    public long maxArea(int[] height) {",
            "        int left = 0, right = height.length - 1;",
            "        long best = 0;",
            "        while (left < right) {",
            "            best = Math.max(best, (long) (right - left) * Math.min(height[left], height[right]));",
            "            if (height[left] <= height[right]) left++; // 移動短邊",
            "            else right--;",
            "        }",
            "        return best;",
            "    }",
            "}"
          ]
        },
        "cpp": {
          "lines": [
            "#include <vector>",
            "#include <algorithm>",
            "long long maxArea(const std::vector<int>& height) {",
            "    int left = 0, right = static_cast<int>(height.size()) - 1;",
            "    long long best = 0;",
            "    while (left < right) {",
            "        best = std::max(best, static_cast<long long>(right - left) * std::min(height[left], height[right]));",
            "        if (height[left] <= height[right]) ++left;",
            "        else --right;",
            "    }",
            "    return best;",
            "}"
          ]
        }
      },
