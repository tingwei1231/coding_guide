  "standard_templates": [
    {
      "id": "bfs",
      "name": "BFS：以佇列逐層走訪",
      "trigger_signal": "無權圖的層級、最少邊數、由近到遠探索。",
      "keywords": [
        "bfs",
        "廣度優先",
        "最少步數",
        "層序"
      ],
      "prerequisites": [
        "graph 為鄰接表，所有節點編號在 [0,n)；start 為有效節點。",
        "只走訪 start 可達的節點；鄰居依輸入順序處理，有向／無向皆可。"
      ],
      "counterexamples": [
        {
          "scenario": "邊的成本不同，卻把第一次到達當成最低成本。",
          "reason": "BFS 保證的是最少邊數；帶權最短路徑需其他方法。"
        }
      ],
      "explanation": "起點入隊就標记 visited；每次取出隊首，依序加入未訪鄰居。標記時機在入隊而非出隊，避免同一節點被不同父節點重複加入。此範例回傳走訪順序，不包含距離陣列。",
      "complexity": {
        "time": "O(V+E)",
        "space": "O(V)",
        "reason": "V、E 為整張圖的節點與邊數。visited 初始化 O(V)，可達邊各查看一次，佇列與輸出至多 O(V)。"
      },
      "code": {
        "python": {
          "lines": [
            "from collections import deque",
            "def bfs(graph, start):",
            "    visited = [False] * len(graph)",
            "    queue = deque([start])",
            "    visited[start] = True  # 入隊時就標記",
            "    order = []",
            "    while queue:",
            "        node = queue.popleft()",
            "        order.append(node)",
            "        for neighbor in graph[node]:",
            "            if not visited[neighbor]:",
            "                visited[neighbor] = True",
            "                queue.append(neighbor)",
            "    return order"
          ]
        },
        "java": {
          "lines": [
            "import java.util.*;",
            "class Solution {",
            "    public List<Integer> bfs(List<List<Integer>> graph, int start) {",
            "        boolean[] visited = new boolean[graph.size()];",
            "        ArrayDeque<Integer> queue = new ArrayDeque<>();",
            "        List<Integer> order = new ArrayList<>();",
            "        queue.addLast(start);",
            "        visited[start] = true; // 入隊就標記",
            "        while (!queue.isEmpty()) {",
            "            int node = queue.removeFirst();",
            "            order.add(node);",
            "            for (int neighbor : graph.get(node)) {",
            "                if (!visited[neighbor]) {",
            "                    visited[neighbor] = true;",
            "                    queue.addLast(neighbor);",
            "                }",
            "            }",
            "        }",
            "        return order;",
            "    }",
            "}"
          ]
        },
        "cpp": {
          "lines": [
            "#include <vector>",
            "#include <queue>",
            "std::vector<int> bfs(const std::vector<std::vector<int>>& graph, int start) {",
            "    std::vector<bool> visited(graph.size(), false);",
            "    std::queue<int> queue;",
            "    std::vector<int> order;",
            "    queue.push(start);",
            "    visited[start] = true; // 入隊就標記",
            "    while (!queue.empty()) {",
            "        int node = queue.front();",
            "        queue.pop();",
            "        order.push_back(node);",
            "        for (int neighbor : graph[node]) {",
            "            if (!visited[neighbor]) {",
            "                visited[neighbor] = true;",
            "                queue.push(neighbor);",
            "            }",
            "        }",
            "    }",
            "    return order;",
            "}"
          ]
        }
      },
