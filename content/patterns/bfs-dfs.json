    {
      "id": "dfs",
      "name": "DFS：遞迴深入走訪",
      "trigger_signal": "探索可達性、連通區域或一路深入的路徑。",
      "keywords": [
        "dfs",
        "深度優先",
        "可達",
        "連通"
      ],
      "prerequisites": [
        "graph 為鄰接表，所有節點編號在 [0,n)；start 為有效節點。",
        "只走訪 start 可達的節點；鄰居依輸入順序處理，有向／無向皆可。",
        "遞迴深度受語言執行環境限制；長鏈圖應改用顯式堆疊，本教學採小圖。"
      ],
      "counterexamples": [
        {
          "scenario": "含環圖只檢查父節點，卻未記錄完整 visited。",
          "reason": "一般圖可能從別的路徑繞回舊節點，需在進入節點時標記，否則可能無限遞迴。"
        }
      ],
      "explanation": "進入節點立刻標記並記錄，依序遞迴每個未訪鄰居。visited 表示整次走訪已看過的節點，與回溯法中需要撤銷的路徑狀態不同；DFS 第一次到達不保證最短路徑。",
      "complexity": {
        "time": "O(V+E)",
        "space": "O(V)",
        "reason": "visited、輸出與最深遞迴鏈至多 O(V)，每條可達邊只檢查一次。"
      },
      "code": {
        "python": {
          "lines": [
            "def dfs(graph, start):",
            "    visited = [False] * len(graph)",
            "    order = []",
            "    def visit(node):",
            "        visited[node] = True  # 進入即標記",
            "        order.append(node)",
            "        for neighbor in graph[node]:",
            "            if not visited[neighbor]:",
            "                visit(neighbor)",
            "    visit(start)",
            "    return order"
          ]
        },
        "java": {
          "lines": [
            "import java.util.*;",
            "class Solution {",
            "    private void visit(List<List<Integer>> graph, int node, boolean[] visited, List<Integer> order) {",
            "        visited[node] = true; // 在遞迴鄰居前標記",
            "        order.add(node);",
            "        for (int neighbor : graph.get(node)) {",
            "            if (!visited[neighbor]) visit(graph, neighbor, visited, order);",
            "        }",
            "    }",
            "    public List<Integer> dfs(List<List<Integer>> graph, int start) {",
            "        boolean[] visited = new boolean[graph.size()];",
            "        List<Integer> order = new ArrayList<>();",
            "        visit(graph, start, visited, order);",
            "        return order;",
            "    }",
            "}"
          ]
        },
        "cpp": {
          "lines": [
            "#include <vector>",
            "#include <functional>",
            "std::vector<int> dfs(const std::vector<std::vector<int>>& graph, int start) {",
            "    std::vector<bool> visited(graph.size(), false);",
            "    std::vector<int> order;",
            "    std::function<void(int)> visit = [&](int node) {",
            "        visited[node] = true;",
            "        order.push_back(node);",
            "        for (int neighbor : graph[node]) {",
            "            if (!visited[neighbor]) visit(neighbor);",
            "        }",
            "    };",
            "    visit(start);",
            "    return order;",
            "}"
          ]
        }
      },
