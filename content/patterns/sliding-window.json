            "class Solution {",
            "    public int[] maxSlidingWindow(int[] nums, int k) {",
            "        ArrayDeque<Integer> candidates = new ArrayDeque<>(); // 索引",
            "        int[] result = new int[nums.length - k + 1];",
            "        for (int right = 0; right < nums.length; right++) {",
            "            while (!candidates.isEmpty() && candidates.peekFirst() <= right - k) {",
            "                candidates.removeFirst(); // 過期",
            "            }",
            "            while (!candidates.isEmpty() && nums[candidates.peekLast()] <= nums[right]) {",
            "                candidates.removeLast(); // 被新值支配",
            "            }",
            "            candidates.addLast(right);",
            "            if (right >= k - 1) result[right - k + 1] = nums[candidates.peekFirst()];",
            "        }",
            "        return result;",
            "    }",
            "}"
