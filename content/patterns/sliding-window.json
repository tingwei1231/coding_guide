            "    long long total = 0; // 1 <= k <= nums.size()",
            "    for (int i = 0; i < k; ++i) total += nums[i];",
            "    long long best = total; // 支援全負數",
            "    for (int right = k; right < static_cast<int>(nums.size()); ++right) {",
            "        total += static_cast<long long>(nums[right]) - nums[right - k];",
            "        best = std::max(best, total);",
            "    }",
