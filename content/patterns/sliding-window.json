            "    for right, char in enumerate(s):",
            "        while char in seen:  # 重複才收縮",
            "            seen.remove(s[left])",
            "            left += 1",
            "        seen.add(char)  # 收縮後才加入新字元",
            "        best = max(best, right - left + 1)  # 合法後更新",
            "    return best"
          ]
        },
        "java": {
          "lines": [
            "import java.util.HashSet;",
            "class Solution {",
            "    public int lengthOfLongestSubstring(String s) {",
            "        HashSet<Character> seen = new HashSet<>(); // window 內字元",
            "        int left = 0, best = 0;",
            "        for (int right = 0; right < s.length(); right++) {",
            "            char ch = s.charAt(right);",
            "            while (seen.contains(ch)) { // 先移除重複",
            "                seen.remove(s.charAt(left++));",
            "            }",
            "            seen.add(ch);",
            "            best = Math.max(best, right - left + 1); // 合法後更新",
