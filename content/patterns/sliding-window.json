        "python": {
          "lines": [
            "def find_max_average(nums, k):",
            "    total = sum(nums[i] for i in range(k))  # 使用生成器，不複製切片",
            "    best = total  # 支援全負數，不能設成 0",
            "    for right in range(k, len(nums)):",
            "        total += nums[right] - nums[right - k]  # 加右、移左",
            "        best = max(best, total)",
            "    return best / k  # 固定長度，最大總和等價於最大平均"
          ]
        },
        "java": {
          "lines": [
            "class Solution {",
            "    public double findMaxAverage(int[] nums, int k) {",
            "        long total = 0; // 1 <= k <= nums.length",
            "        for (int i = 0; i < k; i++) total += nums[i];",
            "        long best = total; // 支援全負數",
            "        for (int right = k; right < nums.length; right++) {",
            "            total += (long) nums[right] - nums[right - k];",
            "            best = Math.max(best, total);",
            "        }",
            "        return (double) best / k; // 避免整數除法",
            "    }",
            "}"
