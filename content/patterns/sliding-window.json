  "standard_templates": [
    {
      "id": "longest-valid",
      "name": "可變窗口：非負數總和不超過上限",
      "trigger_signal": "找總和不超過 budget 的最長連續子陣列，且元素非負。",
      "keywords": [
        "最長",
        "非負數",
        "上限"
      ],
      "prerequisites": [
        "nums 的元素皆為非負整數，budget >= 0。",
        "總和需在 Java/C++ 的 64 位有號整數範圍內。"
      ],
      "counterexamples": [
        {
          "scenario": "nums=[2,-1], budget=1",
          "reason": "若先移除 2，便錯過長度 2 的合法窗口；負數破壞擴張不減、收縮不增的性質。"
        }
      ],
      "explanation": "右端逐步擴張，超過預算才移動左端；非負性保證被淘汰的左端不會因後續擴張重新成為更長的合法答案。空陣列回傳 0。",
      "complexity": {
        "time": "O(n)",
        "space": "O(1)",
        "reason": "左右端各最多走 n 次，只保存索引、總和與答案。"
      },
      "code": {
        "python": {
          "lines": [
            "def longest_within_budget(nums, budget):",
            "    left = total = best = 0  # 非負數，budget >= 0",
            "    for right, value in enumerate(nums):",
            "        total += value  # 擴張右端",
            "        while total > budget:  # 不合法才收縮",
            "            total -= nums[left]",
            "            left += 1",
            "        best = max(best, right - left + 1)  # 合法後更新",
            "    return best"
          ]
        },
        "java": {
          "lines": [
            "class Solution {",
            "    static int longestWithinBudget(int[] nums, long budget) {",
            "        int left = 0, best = 0; // nums 非負，budget >= 0",
            "        long total = 0;",
            "        for (int right = 0; right < nums.length; right++) {",
            "            total += nums[right]; // 擴張",
            "            while (total > budget) { // 恢復合法窗口",
            "                total -= nums[left++];",
            "            }",
            "            best = Math.max(best, right - left + 1);",
            "        }",
            "        return best;",
            "    }",
            "}"
          ]
        },
        "cpp": {
          "lines": [
            "#include <vector>",
            "#include <algorithm>",
            "int longestWithinBudget(const std::vector<int>& nums, long long budget) {",
            "    int left = 0, best = 0; // nums 非負，budget >= 0",
            "    long long total = 0;",
            "    for (int right = 0; right < static_cast<int>(nums.size()); ++right) {",
            "        total += nums[right]; // 擴張",
            "        while (total > budget) { // 恢復合法窗口",
            "            total -= nums[left++];",
            "        }",
            "        best = std::max(best, right - left + 1);",
            "    }",
            "    return best;",
            "}"
          ]
        }
      },
      "problem_ids": [],
