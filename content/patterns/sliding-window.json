  "variations": [
    {
      "id": "fixed-size",
      "name": "固定窗口：最大平均",
      "base_template_id": "longest-valid",
      "trigger_signal": "明確指定長度 k，找連續 k 個元素的最大平均。",
      "keywords": [
        "長度 k",
        "固定窗口",
        "最大平均"
      ],
      "prerequisites": [
        "1 <= k <= nums.length；元素可為負數。",
        "總和及差值需在 Java/C++ 的 64 位有號整數範圍內。"
      ],
      "counterexamples": [
        {
          "scenario": "要求長度至少 k，而非恰好 k。",
          "reason": "只枚舉固定長度會漏掉更長候選，不能直接沿用此模板。"
        }
      ],
      "explanation": "先算首個完整窗口，再每次加入右端、移除 right-k。以首個窗口總和初始化答案以支援全負數。",
      "complexity": {
        "time": "O(n)",
        "space": "O(1)（Python 此寫法 O(k)）",
        "reason": "窗口增量更新；Python nums[:k] 會建立長度 k 的暫存切片，Java/C++ 只用常數額外空間。"
      },
      "code": {
        "python": {
          "lines": [
            "def find_max_average(nums, k):",
            "    total = sum(nums[:k])  # 先建立第一個完整窗口",
            "    best = total  # 支援全負數，不能設成 0",
            "    for right in range(k, len(nums)):",
            "        total += nums[right] - nums[right - k]  # 加右、移左",
            "        best = max(best, total)",
            "    return best / k  # 固定長度，最大總和等價於最大平均"
          ]
        },
        "java": {
          "lines": [
            "class Solution {",
            "    public double findMaxAverage(int[] nums, int k) {",
            "        long total = 0; // 1 <= k <= nums.length",
            "        for (int i = 0; i < k; i++) total += nums[i];",
            "        long best = total; // 支援全負數",
            "        for (int right = k; right < nums.length; right++) {",
            "            total += (long) nums[right] - nums[right - k];",
            "            best = Math.max(best, total);",
            "        }",
            "        return (double) best / k; // 避免整數除法",
            "    }",
            "}"
          ]
        },
        "cpp": {
          "lines": [
            "#include <vector>",
            "#include <algorithm>",
            "double findMaxAverage(const std::vector<int>& nums, int k) {",
            "    long long total = 0; // 1 <= k <= nums.size()",
            "    for (int i = 0; i < k; ++i) total += nums[i];",
            "    long long best = total; // 支援全負數",
            "    for (int right = k; right < static_cast<int>(nums.size()); ++right) {",
            "        total += static_cast<long long>(nums[right]) - nums[right - k];",
            "        best = std::max(best, total);",
            "    }",
            "    return static_cast<double>(best) / k;",
            "}"
          ]
        }
      },
