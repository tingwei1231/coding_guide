        }
      ],
      "explanation": "右端逐步擴張，超過預算才移動左端；非負性保證被淘汰的左端不會因後續擴張重新成為更長的合法答案。空陣列回傳 0。",
      "complexity": {
        "time": "O(n)",
        "space": "O(1)",
        "reason": "左右端各最多走 n 次，只保存索引、總和與答案。"
      },
      "code": {
        "python": {
          "lines": [
            "def longest_within_budget(nums, budget):",
            "    left = total = best = 0  # 非負數，budget >= 0",
            "    for right, value in enumerate(nums):",
            "        total += value  # 擴張右端",
            "        while total > budget:  # 不合法才收縮",
            "            total -= nums[left]",
            "            left += 1",
            "        best = max(best, right - left + 1)  # 合法後更新",
            "    return best"
          ]
        },
        "java": {
          "lines": [
            "class Solution {",
            "    static int longestWithinBudget(int[] nums, long budget) {",
            "        int left = 0, best = 0; // nums 非負，budget >= 0",
            "        long total = 0;",
            "        for (int right = 0; right < nums.length; right++) {",
            "            total += nums[right]; // 擴張",
            "            while (total > budget) { // 恢復合法 window",
            "                total -= nums[left++];",
            "            }",
            "            best = Math.max(best, right - left + 1);",
            "        }",
            "        return best;",
            "    }",
            "}"
          ]
        },
        "cpp": {
          "lines": [
            "#include <vector>",
