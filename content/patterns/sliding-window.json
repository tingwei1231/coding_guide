    {
      "id": "frequency-count",
      "name": "window＋頻率計數：最小覆蓋子字串",
      "keywords": [
        "包含所有字元",
        "頻率",
        "異位詞"
      ],
      "trigger_signal": "包含目標所有字元且重複次數足夠，找最短 window；異位詞則再限制長度。",
      "prerequisites": [
        "三語言以 ASCII 為字元範圍；字元計數包含重複次數。",
        "t 為空或無解時回傳空字串。"
      ],
      "counterexamples": [
        {
          "scenario": "t=AAB，window AB",
          "reason": "集合包含 A、B 仍不足，必須計算 A 的兩次需求；不能只比較相異字元種類。"
        }
      ],
      "explanation": "need 保存剩餘需求，可為負數；missing 是尚缺字元的總次數。補上原本缺少的字元才減少 missing；missing=0 時記答案並收縮。移除必要字元令需求變正時才增加 missing。Permutation in String 可改成固定長度 len(t)，並在長度吻合且 missing=0 時回傳 true；此處實作的是 Minimum Window Substring。",
      "complexity": {
        "time": "O(n+m)",
        "space": "O(Σ)，另計輸出 O(L)",
        "reason": "n、m 為 s、t 長度。每字元至多進出一次；字典或固定 ASCII 陣列存頻率，回傳長度 L 的子字串。"
      },
      "code": {
        "python": {
          "lines": [
            "from collections import Counter",
            "def min_window(s, t):",
            "    if not t:",
            "        return \"\"  # 空目標直接回傳",
            "    need = Counter(t)  # 正數表示尚缺的字元數",
            "    missing = len(t)",
            "    left = start = 0",
            "    best = len(s) + 1",
            "    for right, char in enumerate(s):",
            "        if need[char] > 0:",
            "            missing -= 1  # 只有補上缺口才減少 missing",
            "        need[char] -= 1  # 多餘字元可使計數成為負數",
            "        while missing == 0:",
            "            if right - left + 1 < best:",
            "                start, best = left, right - left + 1",
            "            need[s[left]] += 1  # 先恢復即將離開的字元",
            "            if need[s[left]] > 0:",
            "                missing += 1  # 移除必要字元後失效",
            "            left += 1",
            "    return \"\" if best == len(s) + 1 else s[start:start + best]"
          ]
        },
        "java": {
          "lines": [
            "class Solution {",
            "    public String minWindow(String s, String t) {",
            "        if (t.isEmpty()) return \"\"; // 空目標",
            "        int[] need = new int[128]; // 本範例限 ASCII",
            "        for (int i = 0; i < t.length(); i++) need[t.charAt(i)]++;",
            "        int missing = t.length(), left = 0, start = 0, best = s.length() + 1;",
            "        for (int right = 0; right < s.length(); right++) {",
            "            char ch = s.charAt(right);",
            "            if (need[ch] > 0) missing--; // 補上缺口",
            "            need[ch]--; // 多餘字元可為負數",
            "            while (missing == 0) {",
            "                if (right - left + 1 < best) {",
            "                    start = left;",
            "                    best = right - left + 1;",
            "                }",
            "                char removed = s.charAt(left++);",
            "                if (++need[removed] > 0) missing++; // 移除必要字元",
            "            }",
            "        }",
            "        return best == s.length() + 1 ? \"\" : s.substring(start, start + best);",
            "    }",
            "}"
          ]
        },
        "cpp": {
          "lines": [
            "#include <string>",
            "#include <array>",
            "std::string minWindow(const std::string& s, const std::string& t) {",
            "    if (t.empty()) return \"\"; // 空目標",
            "    std::array<int, 128> need{}; // 本範例限 ASCII",
            "    for (unsigned char ch : t) ++need[ch];",
            "    int missing = static_cast<int>(t.size()), left = 0, start = 0;",
            "    int best = static_cast<int>(s.size()) + 1;",
            "    for (int right = 0; right < static_cast<int>(s.size()); ++right) {",
            "        unsigned char ch = s[right];",
            "        if (need[ch] > 0) --missing; // 補上缺口",
            "        --need[ch];",
            "        while (missing == 0) {",
            "            if (right - left + 1 < best) {",
            "                start = left;",
            "                best = right - left + 1;",
            "            }",
            "            unsigned char removed = s[left++];",
            "            if (++need[removed] > 0) ++missing; // 移除必要字元",
            "        }",
            "    }",
            "    return best == static_cast<int>(s.size()) + 1 ? \"\" : s.substr(start, best);",
            "}"
          ]
        }
      },
