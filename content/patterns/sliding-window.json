            "    int left = 0, best = 0; // nums 非負，budget >= 0",
            "    long long total = 0;",
            "    for (int right = 0; right < static_cast<int>(nums.size()); ++right) {",
            "        total += nums[right]; // 擴張",
            "        while (total > budget) { // 恢復合法 window",
            "            total -= nums[left++];",
            "        }",
            "        best = std::max(best, right - left + 1);",
            "    }",
            "    return best;",
            "}"
