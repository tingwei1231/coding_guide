{
  "name": "coding-guide",
  "private": true,
  "type": "module",
  "scripts": {
    "verify": "npm test && npm run build && npm run test:e2e",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate:content && npm run generate:code && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "generate:code": "node scripts/highlight-code.mjs",
    "predev": "npm run generate:code"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.17.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3"
  }
}
